{
	"name": "server",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"lint": "oxlint --config ../../oxlint.config.mjs --fix . && oxfmt --config ../../oxfmt.config.mjs --write .",
		"lint:check": "oxfmt --config ../../oxfmt.config.mjs --check . && oxlint --config ../../oxlint.config.mjs .",
		"lint:unsafe": "oxlint --config ../../oxlint.config.mjs --fix-dangerously . && oxfmt --config ../../oxfmt.config.mjs --write .",
		"format": "oxfmt --config ../../oxfmt.config.mjs --write .",
		"format:check": "oxfmt --config ../../oxfmt.config.mjs --check .",
		"build": "bun run typecheck",
		"typecheck": "tsc -b",
		"test": "node ../../node_modules/vitest/vitest.mjs run --config test/vitest.config.ts",
		"test:all": "bun run test:unit && bun run test",
		"test:watch": "node ../../node_modules/vitest/vitest.mjs --config test/vitest.config.ts",
		"test:typecheck": "tsc --noEmit -p test/tsconfig.json",
		"test:unit": "bun test test/src",
		"test:auth": "node ../../node_modules/vitest/vitest.mjs run --config test/vitest.config.ts test/src/features/auth",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"predev": "wrangler types",
		"dev": "bun scripts/dev.ts",
		"dev:worker": "bun run db:migrate:local && wrangler types && wrangler dev",
		"dev:wrangler": "bun run db:migrate:local && bun run --cwd ../agent build && wrangler dev --config wrangler.jsonc --config ../agent/dist/open_cash_finance_agent/wrangler.json",
		"debug": "bun run db:migrate:local && wrangler types && wrangler dev --inspector-port 9229",
		"otel-dev": "bun --hot --preload src/otel.ts src/index.ts",
		"db:generate": "drizzle-kit generate --config=./drizzle.config.ts --name",
		"db:migrate": "wrangler d1 migrations apply DATABASE --remote --config wrangler.jsonc",
		"db:migrate:local": "wrangler d1 migrations apply DATABASE --local --config wrangler.jsonc",
		"db:studio": "drizzle-kit studio --config=./drizzle.config.ts",
		"db:studio:prod": "ALCHEMY_STAGE=prod drizzle-kit studio --config=./drizzle.config.ts",
		"auth:generate": "bun ./node_modules/@better-auth/cli/dist/index.mjs generate --config src/lib/auth.cli.ts --output src/db/models/authModels.ts -y",
		"proto:gen": "buf generate"
	},
	"dependencies": {
		"@better-auth/agent-auth": "^0.6.2",
		"@better-auth/api-key": "1.6.23",
		"@better-auth/core": "1.6.23",
		"@hono/zod-openapi": "1.5.1",
		"@modelcontextprotocol/server": "^2.0.0",
		"@open-cash/files": "workspace:*",
		"@orpc/openapi": "^1.14.8",
		"@orpc/server": "^1.14.8",
		"@orpc/zod": "^1.14.8",
		"@scalar/hono-api-reference": "^0.9.48",
		"better-auth": "catalog:",
		"better-auth-cloudflare": "^0.3.0",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "catalog:",
		"hono-problem-details": "0.10.1",
		"hono-rate-limiter": "^0.5.3",
		"kysely": "0.28.17",
		"s3mini": "^0.9.5",
		"uuid": "^11.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@better-auth/cli": "1.4.21",
		"@cloudflare/vitest-pool-workers": "catalog:",
		"@types/node": "^26.1.1",
		"drizzle-kit": "^0.31.10",
		"testcontainers": "^11.14.0",
		"typescript": "^7.0.2",
		"vite": "8.1.5",
		"vitest": "^4.1.10"
	}
}
