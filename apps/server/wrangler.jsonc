// Generated by Alchemy from the Worker resource.
// Secret values are not written here. Use `.dev.vars` or `wrangler dev --env-file`.
{
  "name": "open-cash-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "dev": {
    "port": 8787
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGIN": "https://open-cash.dev,http://localhost:5055",
    "EMAIL_FROM_ADDRESS": "noreply@open-cash.dev",
    "EMAIL_FROM_NAME": "Open-Cash",
    "AUTH_BASE_PATH": "/v1/auth",
    "AUTH_OPEN_API_PATH": "/docs",
    "AUTH_ENABLE_DELETE_ACCOUNT": false,
    "AUTH_SESSION_DURATION_SECONDS": 1209600,
    "ENABLE_OPEN_API": "true",
    "SCALAR_THEME": "deepSpace",
    "DEFAULT_PAGE_SIZE": 100,
    "DEFAULT_MAX_PAGE_SIZE": 1000
  },
  "secrets": {
    "required": [
      "AUTH_SECRET",
      "FINANCE_ENCRYPTION_KEY",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "3a1cc929a1ad49988f1d65d098c7e1d5",
      "preview_id": "3a1cc929a1ad49988f1d65d098c7e1d5"
    },
    {
      "binding": "SHARED_KV",
      "id": "0c46519c21b2439192fa79218f4a11bb",
      "preview_id": "0c46519c21b2439192fa79218f4a11bb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "open-cash-bucket",
      "preview_bucket_name": "open-cash-bucket"
    }
  ],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "open-cash-d1",
      "database_id": "0b4b6de0-0c07-493b-bbe5-9474121c12e9",
      "preview_database_id": "0b4b6de0-0c07-493b-bbe5-9474121c12e9",
      "migrations_dir": "./src/db/migrations",
      "migrations_table": "d1_migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 10
      }
    }
  ],
  "services": [
    {
      "binding": "AGENT_SERVICE",
      "service": "open-cash-finance-agent"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_IDENTITY",
        "class_name": "UserIdentityDO",
        "script_name": "open-cash-finance-agent"
      }
    ]
  },
  "version_metadata": {
    "binding": "VERSION_METADATA"
  }
}
