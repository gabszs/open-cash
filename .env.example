# Deploy-time environment for `alchemy deploy`.
#
# Alchemy resolves every `Config.*` declared in `infra/` against this process's
# environment. Bun loads a root `.env` automatically, so copy this file to
# `.env` and fill it in. Values marked (secret) are uploaded as `secret_text`
# bindings on the Worker — they are never written into any wrangler.jsonc.

# ── Cloudflare credentials ─────────────────────────────────────────────────
# Either a scoped API token, or CLOUDFLARE_API_KEY + CLOUDFLARE_EMAIL.
# Omit both to fall back to the OAuth profile stored by `alchemy login`.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_EMAIL=

# ── Public hostnames ───────────────────────────────────────────────────────
# The Cloudflare zone must exist in the account used for deployment.
OPEN_CASH_WEB_HOSTNAME=open-cash.example.com
OPEN_CASH_API_HOSTNAME=api.open-cash.example.com

# ── Required secrets (no default — deploy fails if unset) ──────────────────
# Signs Better Auth sessions.
AUTH_SECRET=
# Seals each user's Pluggy client secret before it is stored in D1. Rotating it
# invalidates every stored connection credential.
FINANCE_ENCRYPTION_KEY=

# ── Optional secrets (social login — leave blank to disable a provider) ────
# Both values of a pair are required; either one missing and Better Auth does
# not register that provider at all.
# GitHub callback URL: https://api.open-cash.example.com/v1/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google callback URL: https://api.open-cash.example.com/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Pluggy user connections ───────────────────────────────────────────────
# Pluggy credentials are intentionally not global deployment variables here.
# Each authenticated user creates one or more connections in the Open Cash
# settings flow with their clientId, clientSecret and itemIds. Do not add
# PLUGGY_CLIENT_ID, PLUGGY_CLIENT_SECRET or PLUGGY_ITEM_IDS to this file.

# ── API vars (optional — infra/workers/api.ts holds the defaults) ──────────
CORS_ORIGIN=https://open-cash.example.com,http://localhost:5055
EMAIL_FROM_ADDRESS=noreply@open-cash.example.com
EMAIL_FROM_NAME=open-cash
AUTH_BASE_PATH=/v1/auth
AUTH_OPEN_API_PATH=/docs
AUTH_ENABLE_DELETE_ACCOUNT=false
AUTH_SESSION_DURATION_SECONDS=1209600
ENABLE_OPEN_API=true
SCALAR_THEME=deepSpace
DEFAULT_PAGE_SIZE=100
DEFAULT_MAX_PAGE_SIZE=1000

# ── Agent vars (optional) ──────────────────────────────────────────────────
# Defaults to the deployed API's /mcp endpoint.
FINANCE_MCP_URL=https://api.open-cash.example.com/mcp

# ── Docker (only if you run more than one daemon) ──────────────────────────
# The agent's sandbox image is built and pushed locally. Alchemy runs the push
# under an isolated DOCKER_CONFIG to inject registry credentials, which also
# drops the `docker context` selection — so the push lands on the `default`
# daemon while the build stayed on whichever context is active, and fails with
# "An image does not exist locally with the tag". Pinning DOCKER_HOST wins over
# contexts and keeps both on the same daemon. Check yours with `docker context ls`.
# DOCKER_HOST=unix:///home/<you>/.docker/desktop/docker.sock

# ── drizzle-kit studio against the deployed D1 (bun run db:studio:prod) ────
# CLOUDFLARE_D1_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_D1_API_TOKEN=
